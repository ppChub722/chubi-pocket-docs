# Release brief facts — see README.md. Copy this folder outside the repos.
# The tag v<VERSION> must exist and be pushed in be, app and docs.
VERSION=0.3.1-9
# New migration numbers ("53 54") or none: checked against the be tag vs prod
EXPECT_MIGRATIONS=none
# unchanged, or the new floor (a forced update)
MIN_APP_BUILD=unchanged
# y = a QA pass ran on this tree
QA=n
# Optional, default n: y = leave that side out (BE-only / app-only release)
SKIP_BE=n
SKIP_APP=n
